<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Masukkan nilai gizi untuk SATU porsi berdasarkan label kemasan atau sumber yang kamu gunakan. Menyimpan katalog tidak langsung mencatat konsumsi." />
        <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nama makanan / minuman" android:inputType="textCapSentences" android:minHeight="48dp" />
        <EditText android:id="@+id/serving" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Takaran 1 porsi, mis. 200 ml" android:inputType="text" android:minHeight="48dp" />
        <EditText android:id="@+id/inputCalories" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Energi (kkal)" android:inputType="numberDecimal" android:minHeight="48dp" />
        <EditText android:id="@+id/inputSugar" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Gula total (g)" android:inputType="numberDecimal" android:minHeight="48dp" />
        <EditText android:id="@+id/inputSodium" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Natrium (mg)" android:inputType="numberDecimal" android:minHeight="48dp" />
        <EditText android:id="@+id/inputProtein" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Protein (g)" android:inputType="numberDecimal" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
